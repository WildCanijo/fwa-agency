# Copy to .env.local and fill in. See src/lib/contact-delivery.ts and src/lib/form-guard.ts.

# Public site URL, used for canonical links and Open Graph images.
NEXT_PUBLIC_SITE_URL=https://romanoweb.com

# Contact form delivery (Resend). Without these the form tells visitors their message was NOT sent.
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL=Romano Web <onboarding@resend.dev>
RESEND_API_KEY=

# Form protection: at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CONTACT_FORM_SECRET=

# Optional Cloudflare Turnstile human check. Leave empty to turn off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
