# Copy to .env.local and fill in. See src/lib/contact-delivery.ts and src/lib/form-guard.ts.

# Optional. Public site URL for canonical links and share images.
# On Netlify it defaults to the site's live address (Netlify's built-in URL).
NEXT_PUBLIC_SITE_URL=

# Contact form delivery (Resend). Without RESEND_API_KEY the form tells visitors their message was NOT sent.
RESEND_API_KEY=
# Optional: defaults to the public email in src/config/site.ts.
CONTACT_TO_EMAIL=
# Optional: sender address; defaults to onboarding@resend.dev. The display name is always "Romano Web".
CONTACT_FROM_EMAIL=

# Form protection: at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CONTACT_FORM_SECRET=

# Optional Cloudflare Turnstile human check. Leave empty to turn off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
